{
  "name": "traqq-backend",
  "version": "1.0.0",
  "description": "TRAQQ Premium Airport Shuttle Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:admin": "node prisma/seed.js",
    "cleanup:test-users": "node scripts/cleanupTestUsers.js",
    "cleanup:test-users:bookings": "node scripts/cleanupTestUsers.js --bookings",
    "test:email": "node -r dotenv/config scripts/test-email.js",
    "test": "node --test --test-reporter=spec tests/date-utils.test.js tests/date-format.test.js tests/booking-date.integration.test.js",
    "test:unit": "node --test --test-reporter=spec tests/date-utils.test.js tests/date-format.test.js",
    "test:integration": "node --test --test-reporter=spec tests/booking-date.integration.test.js",
    "test:dates": "node --test --test-reporter=spec tests/date-utils.test.js tests/date-format.test.js tests/booking-date.integration.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.4.1",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "stripe": "^16.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.14.0"
  }
}
