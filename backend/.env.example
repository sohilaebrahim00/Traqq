# =============================================================
# TRAQQ Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ---- Node ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# Local SQLite (development):
DATABASE_URL="file:./prisma/dev.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://traqq_user:PASSWORD@localhost:5432/traqq_db?schema=public"

# ---- JWT ----
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run twice — use a DIFFERENT value for each secret.
JWT_SECRET="CHANGE_ME_64_char_hex"
JWT_REFRESH_SECRET="CHANGE_ME_different_64_char_hex"

# ---- Stripe ----
# Use a Restricted Key (rk_live_...) with minimum required permissions:
#   Payment Intents — Read + Write
#   Checkout Sessions — Write
# Publishable key (safe to expose to frontend):
STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Restricted/Secret key (server-side only, never in frontend):
STRIPE_RESTRICTED_KEY="rk_live_..."
# Webhook signing secret (from Stripe Dashboard > Webhooks > Signing secret):
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Frontend / CORS ----
FRONTEND_URL="http://localhost:3000"

# ---- Admin Seed Credentials ----
ADMIN_EMAIL="admin@traqq.local"
ADMIN_PHONE="0000000000"
ADMIN_NAME="TRAQQ Admin"
ADMIN_PASSWORD="Admin@123456"
