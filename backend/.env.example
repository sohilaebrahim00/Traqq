# =============================================================
# TRAQQ Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ---- Node ----
# Use "production" on the VPS; "development" locally.
NODE_ENV=development
PORT=4000

# ---- Database ----
# schema.prisma always uses "postgresql" — this value must be a PostgreSQL URL in all environments.
#
# Local dev (Option A — Docker, easiest):
#   docker run -d --name traqq-db -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:15
#   DATABASE_URL="postgresql://postgres:dev@localhost:5432/traqq_dev?schema=public"
#
# Local dev (Option B — existing local PostgreSQL):
#   createdb traqq_dev
#   DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PG_PASSWORD@localhost:5432/traqq_dev?schema=public"
#
# Production (Hostinger VPS — populated by scripts/setup-vps-env.sh):
#   DATABASE_URL="postgresql://traqq_user:STRONG_PASSWORD@localhost:5432/traqq_db?schema=public"
#
DATABASE_URL="postgresql://postgres:dev@localhost:5432/traqq_dev?schema=public"

# ---- JWT ----
# Generate both secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run the command TWICE and use a DIFFERENT value for each variable.
# Minimum 64 random bytes (128 hex chars). Never use the same value for both.
JWT_SECRET="REPLACE_WITH_128_HEX_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_128_HEX_CHARS"

# ---- Stripe ----
# Use a Restricted Key (rk_live_...) — never a full Secret Key.
# Required permissions on the restricted key:
#   Payment Intents   — Read + Write  (booking checkout)
#   Checkout Sessions — Write         (package purchases)
#
# Publishable key — safe to expose to the browser (used by Stripe.js):
STRIPE_PUBLISHABLE_KEY="pk_live_REPLACE_ME"
#
# Restricted key — server-side only, never sent to the browser:
STRIPE_RESTRICTED_KEY="rk_live_REPLACE_ME"
#
# Webhook signing secret — from Stripe Dashboard > Webhooks > Signing secret:
#   1. Go to dashboard.stripe.com/webhooks
#   2. Click "Add endpoint"
#   3. URL: https://traqq.com/api/payments/webhook
#   4. Events to listen for: payment_intent.succeeded  payment_intent.payment_failed  checkout.session.completed
#   5. Copy the "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# ---- Frontend / CORS ----
# The origin Nginx serves the frontend from.
# Dev: http://localhost:3000 (or wherever you serve the frontend)
# Production: https://traqq.com
FRONTEND_URL="http://localhost:3000"

# ---- Google Maps ----
# Required for address autocomplete on the booking form.
# Setup:
#   1. Go to console.cloud.google.com → APIs & Services → Credentials
#   2. Create an API key
#   3. Enable: Maps JavaScript API  +  Places API
#   4. Restrict the key to HTTP referrers: https://traqq.com/*  https://www.traqq.com/*
#   5. Paste the key below
# The key is served to the frontend via GET /api/config (never stored in the browser bundle).
GOOGLE_MAPS_API_KEY="REPLACE_ME_OR_LEAVE_EMPTY_TO_DISABLE_AUTOCOMPLETE"

# ---- Email / Notifications ----
# Required for booking confirmations, trip reminders, and driver status notifications.
# Leave all EMAIL_* vars unset to disable email (app runs normally, just silently skips sends).
#
# Option A — Gmail with an App Password (easiest for small deployments):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=your@gmail.com
#   EMAIL_PASS=xxxx xxxx xxxx xxxx   ← 16-char App Password from myaccount.google.com/apppasswords
#
# Option B — Mailgun SMTP:
#   EMAIL_HOST=smtp.mailgun.org
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=postmaster@mg.traqq.com
#   EMAIL_PASS=your-mailgun-smtp-password
#
# Option C — Any transactional SMTP (SendGrid, SES, Brevo, etc.): fill in appropriately.
#
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="REPLACE_WITH_SMTP_USER"
EMAIL_PASS="REPLACE_WITH_SMTP_PASSWORD_OR_APP_PASSWORD"
# Display name + address shown in the From header (optional — defaults to EMAIL_USER):
EMAIL_FROM="TRAQQ Airport Shuttle <noreply@mytraqq.com>"

# ---- Admin Seed Credentials ----
# Used by: npm run seed:admin
# Change these before production deployment.
# The password is bcrypt-hashed before storage — the plain text is never persisted.
ADMIN_EMAIL="admin@traqq.com"
ADMIN_PHONE="0000000000"
ADMIN_NAME="TRAQQ Admin"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
