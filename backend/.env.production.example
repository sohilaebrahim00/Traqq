# =============================================================
# TRAQQ — PRODUCTION Environment Variables
# =============================================================
# 1. Copy:    cp .env.production.example .env
# 2. Fill in every value — no placeholder must survive
# 3. Protect: chmod 600 .env
# 4. NEVER commit .env — it is in .gitignore
# =============================================================

# ---- Runtime ------------------------------------------------
NODE_ENV=production
PORT=3000

# ---- PostgreSQL ---------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://traqq_user:STRONG_DB_PASSWORD@localhost:5432/traqq_db?schema=public"

# ---- JWT ----------------------------------------------------
# Generate both with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run the command TWICE — use a DIFFERENT value for each secret.
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_CHAR_HEX"

# ---- Stripe -------------------------------------------------
# Publishable key (safe to expose to the browser):
STRIPE_PUBLISHABLE_KEY="pk_live_REPLACE_ME"

# Restricted Key — minimum required permissions:
#   Payment Intents: Read + Write    (for booking checkout)
#   Checkout Sessions: Write         (for package purchases)
# Verify/set permissions at: https://dashboard.stripe.com/apikeys
STRIPE_RESTRICTED_KEY="rk_live_REPLACE_ME"

# Webhook signing secret (Stripe Dashboard > Webhooks > your endpoint > Signing secret):
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# ---- Domain -------------------------------------------------
FRONTEND_URL="https://traqq.com"

# ---- Admin Seed Credentials ---------------------------------
# Used by: npm run seed:admin
# Set a real password. Never use this default.
ADMIN_EMAIL="admin@traqq.com"
ADMIN_PHONE="+10000000000"
ADMIN_NAME="TRAQQ Admin"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
